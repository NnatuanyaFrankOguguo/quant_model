# Copy to `.env` and fill in. `.env` is git-ignored and must stay that way —
# `.pre-commit-config.yaml` runs gitleaks so a real value cannot reach a remote by accident.
# Once a secret is pushed anywhere it is compromised and must be rotated, force-push or not
# (docs/03_ROADMAP_PART1_PHASES_0-6.md, P0.7).

# --- Database (required) --------------------------------------------------------------
# Neon managed PostgreSQL 18 (ADR-0008). `sslmode=require` is not optional.
# The value is a real credential: it is the database password, in plain text, in this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# A SEPARATE database. The test suite drops and recreates the schema in it, and
# tests/conftest.py hard-fails if this resolves to the same database as DATABASE_URL —
# a test run that can destroy the dev schema is a P0 defect, not an inconvenience.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/quant_test?sslmode=require

# --- Environment ----------------------------------------------------------------------
# local | staging | production. Today this is a LABEL, not a boundary — nothing enforces
# that `local` points at a non-production database. ADR-0008 records what has to change
# before P9 puts anyone but the owner in front of this.
ENVIRONMENT=local

# Everything is stored and computed in UTC (TG21). NGX closes 14:30 WAT = 13:30 UTC.
# Do not set this to a local zone to make a timestamp read nicely; that is the bug.
TZ=UTC

# --- Console (packages/common/console.py) ---------------------------------------------
# Every script and the scheduler log colour-coded, step-numbered lines: blue = info,
# green = success, yellow = warning, red = error; steps are 1, 1.1, 1.2, 2 ... by nesting.
# `console` for people, `json` (one object per line) for a log aggregator.
LOG_FORMAT=console
LOG_LEVEL=INFO
# Colour is automatic on a terminal and off on a pipe. NO_COLOR=1 forces it off,
# FORCE_COLOR=1 forces it on. Every line is passed through the secret redactor first.

# --- Connectors (P1+) -----------------------------------------------------------------
# Free, instant: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# EDGAR requires a real name and email in the User-Agent or it blocks you (P2).
SEC_USER_AGENT="Your Name your@email.com"

# --- LLM (P3+) ------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Hard cap. `llm_spend` rows with principal_id NULL are scheduler spend — which is exactly
# the spend a per-principal cap would never stop (docs/08 §2.15).
LLM_MONTHLY_CAP_USD=50

# --- Delivery (P5+) -------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Object storage (P1 local disk, R2/B2 at P9) --------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quant-documents

# --- Backup (the gpg/rclone chain is deferred to P3 entry, docs/10 §6.1) --------------
# Deliberately empty in P0: scripts/backup.ps1 writes an UNENCRYPTED dump to a second
# location. That is honest for an empty schema and unacceptable once real data lands.
BACKUP_GPG_ID=
BACKUP_DIR=

# --- Dead-man pings (docs/10 §5.3) -----------------------------------------------------
# A local check cannot report that the local machine is dead. Each of these is a free
# healthchecks.io URL that the corresponding script pings ONLY on a clean run: if the
# script stops running - laptop off, stolen, scheduler never started - the ping stops and
# healthchecks.io emails you. Left blank, both scripts say so and carry on.
#
# Two variables, not one, on purpose. A single shared URL would let either script's pings
# cover the other's silence, so the backup running nightly would mask ingestion having
# stopped a week ago, which is precisely the failure §5.3 is about.
HEARTBEAT_PING_URL=
HEALTHCHECK_PING_URL=
